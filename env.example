# Airflow image and project settings
AIRFLOW_IMAGE_NAME=my-airflow-image3:3.1.0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UID=50000

# Airflow execution and database
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME_POSTGRES_PASSWORD@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=

AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags/

AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Airflow 3 API and authentication
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__API__SECRET_KEY=CHANGE_ME_AIRFLOW_API_SECRET
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME_AIRFLOW_JWT_SECRET

AIRFLOW_CONN_FS_DEFAULT='fs://?path=/'

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=airflow

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
